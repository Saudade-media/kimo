{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege (ADR 0012 §5): the editor and Settings windows may call exactly the kimo_* commands of TauriCommandMap and listen to kimo:// events. No plugin default sets: dialogs, opener, updater and deep links are driven from Rust.",
  "windows": ["main", "editor-*", "settings", "document-host"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-kimo-app-info",
    "allow-kimo-fs-read-text",
    "allow-kimo-fs-read-bytes",
    "allow-kimo-fs-write-text-atomic",
    "allow-kimo-fs-write-bytes-atomic",
    "allow-kimo-fs-remove",
    "allow-kimo-fs-stat",
    "allow-kimo-fs-list",
    "allow-kimo-fs-watch",
    "allow-kimo-fs-unwatch",
    "allow-kimo-fs-reveal",
    "allow-kimo-fs-open-default",
    "allow-kimo-open-url",
    "allow-kimo-dialog-open-file",
    "allow-kimo-dialog-save-file",
    "allow-kimo-dialog-pick-folder",
    "allow-kimo-recents-list-files",
    "allow-kimo-recents-note-opened",
    "allow-kimo-recents-remove-file",
    "allow-kimo-recents-clear",
    "allow-kimo-recents-list-folders",
    "allow-kimo-recents-add-folder",
    "allow-kimo-recents-remove-folder",
    "allow-kimo-recents-scan-folder",
    "allow-kimo-lease-acquire",
    "allow-kimo-lease-release",
    "allow-kimo-lease-inspect",
    "allow-kimo-lease-watch",
    "allow-kimo-lease-unwatch",
    "allow-kimo-recovery-dir",
    "allow-kimo-recovery-list",
    "allow-kimo-recovery-write",
    "allow-kimo-recovery-read",
    "allow-kimo-recovery-discard",
    "allow-kimo-recovery-prune",
    "allow-kimo-git-state",
    "allow-kimo-git-watch",
    "allow-kimo-git-unwatch",
    "allow-kimo-git-merge-driver-status",
    "allow-kimo-git-install-merge-driver",
    "allow-kimo-fonts-list-local",
    "allow-kimo-fonts-load-local",
    "allow-kimo-fonts-cache-get",
    "allow-kimo-fonts-cache-put",
    "allow-kimo-fonts-cache-list",
    "allow-kimo-fonts-cache-stats",
    "allow-kimo-fonts-cache-clear",
    "allow-kimo-fonts-fetch-remote",
    "allow-kimo-fonts-open-cache-folder",
    "allow-kimo-updater-status",
    "allow-kimo-updater-check",
    "allow-kimo-updater-download",
    "allow-kimo-updater-restart",
    "allow-kimo-window-state",
    "allow-kimo-window-set-title",
    "allow-kimo-window-set-document-edited",
    "allow-kimo-window-open-settings",
    "allow-kimo-window-confirm-close",
    "allow-kimo-window-close",
    "allow-kimo-settings-get-all",
    "allow-kimo-settings-set",
    "allow-kimo-launch-take-initial",
    "allow-kimo-help-show-logs"
  ]
}
