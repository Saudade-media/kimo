{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mcp-host",
  "description": "The hidden document host (ADR 0002 Option A, ADR 0013 §7): every kimo_mcp_* command, including the relay's host side (kimo_mcp_send, kimo_mcp_http_respond, kimo_mcp_host_ready), plus listening to and emitting kimo:// events. It also gets the M4 command surface through the default capability.",
  "windows": ["document-host"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "allow-kimo-mcp-status",
    "allow-kimo-mcp-connections",
    "allow-kimo-mcp-disconnect",
    "allow-kimo-mcp-send",
    "allow-kimo-mcp-http-respond",
    "allow-kimo-mcp-host-ready",
    "allow-kimo-mcp-http-set-enabled",
    "allow-kimo-mcp-http-token-rotate",
    "allow-kimo-mcp-config-read",
    "allow-kimo-mcp-config-write",
    "allow-kimo-mcp-activity-append",
    "allow-kimo-mcp-activity-read",
    "allow-kimo-mcp-policies-get",
    "allow-kimo-mcp-policies-set",
    "allow-kimo-mcp-server-start",
    "allow-kimo-mcp-server-stop",
    "allow-kimo-mcp-server-restart",
    "allow-kimo-mcp-server-settings-get",
    "allow-kimo-mcp-server-settings-set",
    "allow-kimo-mcp-port-check",
    "allow-kimo-mcp-http-token-get",
    "allow-kimo-mcp-log-info",
    "allow-kimo-mcp-log-reveal",
    "allow-kimo-mcp-scope-allow"
  ]
}
