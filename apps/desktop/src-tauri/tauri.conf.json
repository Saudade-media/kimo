{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimo",
  "version": "0.0.0",
  "identifier": "dev.kimo.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --filter @kimo/web dev",
    "beforeBuildCommand": "bun run --filter @kimo/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kimo",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first, agent-native design canvas",
    "copyright": "Copyright (c) 2026 Kimo contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["kimo"],
        "name": "Kimo Document",
        "description": "Kimo design document",
        "role": "Editor",
        "mimeType": "application/vnd.kimo+json"
      }
    ]
  }
}
