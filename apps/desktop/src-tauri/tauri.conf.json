{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimo",
  "version": "0.0.0",
  "identifier": "dev.kimo.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --filter @kimo/web dev",
    "beforeBuildCommand": "bun run --filter @kimo/web build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first, agent-native design canvas",
    "copyright": "Copyright (c) 2026 Kimo contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["kimo"],
        "name": "Kimo Document",
        "description": "Kimo design document",
        "role": "Editor",
        "mimeType": "application/vnd.kimo+json"
      },
      {
        "ext": ["kimoz"],
        "name": "Kimo Package",
        "description": "Kimo document package",
        "role": "Editor",
        "mimeType": "application/vnd.kimo+zip"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kimo"]
      }
    },
    "updater": {
      "pubkey": "UPDATER_PUBKEY_PLACEHOLDER",
      "endpoints": [
        "https://github.com/kimo-design/kimo/releases/latest/download/latest-stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
