, "ReS120": {"type":"text","parent":"iRqMT0","order":"a2","name":"Intro","w":{"mode":"fill"},"content":"Share a file through a relay you host yourself. The relay is blind: it moves encrypted updates and never sees the design. No accounts: a signed link carries the role (View or Edit) and an expiry, each link can be revoked, and Reset all links rotates the key. People get a cursor in a presence color, agents keep their persona hue and claim the frame they edit. Humans are never blocked.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-lg"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

