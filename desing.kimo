, "vAeah0": {"type":"text","parent":"JbxW60","order":"a1","name":"Spec","w":{"mode":"fill"},"content":"Every kimo_apply_ops result lists problems in the layers it just changed, at most 8, one line each: node id, kind, fix. Kinds: empty frame, zero size, text overflowing its box, clipped or outside its parent, missing variable, invisible shape. kimo_validate {check: true} reports the same for the whole page plus placeholders still set. The agent fixes them before moving on and ends with none. Nothing is shown to the person; the canvas is unchanged.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-xs"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

