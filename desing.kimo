, "vbMD10": {"type":"text","parent":"nOM8Y0","order":"a1","name":"Spec","w":{"mode":"fill"},"content":"N agents = N sessions billed in parallel; the warn-per-turn threshold covers the sum. Each child's cost shows on its presence chip and in the mode summary.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-xs"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

