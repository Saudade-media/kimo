, "w4ZH3b": {"type":"text","parent":"n1TAXO","order":"a1","name":"Spec","w":{"mode":"fill"},"content":"Agents plan the sections first, then build each one complete in its own kimo_apply_ops call: the page frame (placeholder: true) with its first finished section, then one finished section per call, sized to what it needs (often 8 to 25 new layers). Every call leaves the canvas coherent: no empty section frames, placeholder-only boxes or half-built sections between calls. A section larger than the limit is split into finished sub-blocks (heading row, then card grid). A variant or restructure starts with one copy of the existing frame or page, then only the new parts are inserted.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-xs"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

, "w4ZW9O": {"type":"instance","parent":"FLTbw0","order":"a2","name":"Image · moodboard.png","of":"PeXjy0","props":{"w":24,"h":24},"overrides":{"BnTL30":{"set":{"y":0,"w":24,"h":24}},"NNiWS0":{"set":{"visible":false}}}}

