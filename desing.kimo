, "mqta40": {"type":"text","parent":"Zwqc40","order":"a5","name":"Note","w":{"mode":"fill"},"content":"The refusal is a correction for the agent, not a failure for the person: no error card, no failed step, the steps toggle does not open, and the status line keeps the agent's current note. errors[0] = {code: BATCH_TOO_LARGE, detail: {limit: 40, newLayers: 62}, suggestion: \"Split into finished parts of ≤ 40 new layers: one complete section, or one complete sub-block of a large section, per call.\"}. Copies, duplicates and instances never count.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-xs"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

