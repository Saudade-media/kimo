, "E24J60": {"type":"text","parent":"Od7YH0","order":"a2","name":"Decision","w":{"mode":"fill"},"content":"Shown only when exactly one main component + one other node (not an instance of it) are selected. The selection's layers become the main's children (main keeps id, name, props and position); overrides re-attach by layer name path, then by type + order. Unmatched overrides aren't lost — they land in the Fix broken overrides review. One undo step.","grow":"fixed-width","style":{"font":{"$ref":"font-sans"},"size":{"$ref":"text-sm"},"weight":400,"lineHeight":1.45},"fill":{"$ref":"text-secondary"}}

