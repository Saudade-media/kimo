              "name": "Eyebrow",
              "fill": "$accent-text",
              "content": "KIMO · V1 COMPLETENESS · THE GAPS THE DOCS AUDIT FOUND BEFORE 1.0 FEELS FINISHED",
              "fontFamily": "$font-mono",
              "fontSize": "$text-sm",
              "fontWeight": "normal",
              "letterSpacing": 0.5
            },
            {
              "type": "text",
              "id": "k6Z2j4",
