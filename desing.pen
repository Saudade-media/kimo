            {
              "type": "text",
              "id": "f5ZFpp",
              "name": "Intro",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Ten areas the user guide had to hedge around: pages, clipboard and structure edits, raster import, view options, polygon/star and pen extras, the missing property controls, variable binding on every field, component flows, Preview, and the agent/export leftovers. Each section is a set of in-context vignettes built from existing components and tokens, closed by a rules table the builders can implement against. Monochrome by default; colour only where it means something — selection blue for targets and insertion, danger for invalid drops, component violet, agent teal, measure magenta.",
              "lineHeight": 1.45,
              "fontFamily": "$font-sans",
              "fontSize": "$text-lg",
              "fontWeight": "normal"
            }
          ]
