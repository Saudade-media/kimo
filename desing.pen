                          "fill": "$text-tertiary",
                          "content": "WHY",
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Sts8J",
                          "name": "Why",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Built from the UI's most recognisable shape (radius-pill). The opening is the viewport; the offset arms imply rotation, so it can spin while an agent works.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "J2NOfT",
                          "name": "Risk label",
                          "fill": "$warning",
                          "content": "RISK",
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "anoyK",
                          "name": "Risk",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Six arms can read as a snowflake or asterisk, and the opening closes below 32 px. Nearest neighbour: the thin-ray starburst — separated by thick rounded arms, offset (not radial) axes and the open centre.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
