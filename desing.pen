                      "name": "Section Title",
                      "fill": "$text-primary",
                      "content": "A × F — Pill bloom × Pucker · three mixes to fine-tune",
                      "fontFamily": "$font-sans",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "f77vMQ",
