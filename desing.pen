                        {
                          "type": "text",
                          "id": "clS2O",
                          "name": "Why",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Solid disc shared; the lobed opening replaces the letter. Distinct, reads as a rosette first.",
