                          "name": "Rationale Title",
                          "fill": "$text-primary",
                          "content": "Why one violet hue (and not monochrome)",
                          "fontFamily": "$font-sans",
                          "fontSize": "$text-base",
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "YJiHS",
                          "name": "Rationale",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Components need an identity that survives on any user canvas and never reads as selection (blue), agent (teal), measure (magenta) or status. Ink-only glyphs and dashed outlines vanish on ink-heavy designs and collide with dashed slot/measure guides, so M3 adds one hue, component (violet, Figma's convention), used only for: main/instance glyphs, main/instance canvas outlines and labels, slot outlines and badges, and the override dot. It is never used for actions or chrome.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-sans",
                          "fontSize": "$text-sm",
                          "fontWeight": "normal"
                        }
                      ]
                    }
