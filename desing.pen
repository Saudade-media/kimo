                    },
                    {
                      "type": "text",
                      "id": "N1FgP",
                      "name": "Note",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A derived component is an instance marked component (Create derived component in the instance ⋯ menu). It keeps the component glyph plus a “from <base>” line in layers, on the canvas label and on asset tiles.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-sans",
                      "fontSize": "$text-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "NUVxH",
                      "name": "Note",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Inherited props are read-only (lock) and dimmed. Redeclaring a prop by name overrides it (here showBadge defaults to true); its reset icon drops the redeclaration and falls back to the base.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-sans",
                      "fontSize": "$text-sm",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "SpPRR",
                      "name": "Note",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Enum props store options as option → value for field; there is no enum default — an instance without the arg renders as authored.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-sans",
                      "fontSize": "$text-sm",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
