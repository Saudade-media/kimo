                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "h05KlP",
                  "name": "Footnote",
                  "fill": "$text-tertiary",
                  "textGrowth": "fixed-width",
                  "width": 1600,
                  "content": "Silhouettes are deliberately rough stand-ins for each family of marks, drawn from primitives for a distance check only. Nothing here is traced. Final pick should still get a trademark search.",
                  "fontFamily": "$font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
