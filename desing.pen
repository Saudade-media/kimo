                              "fontFamily": "$font-sans",
                              "fontSize": 22,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "KL87j",
                              "name": "What",
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A's full pill-bloom silhouette with F's lobed opening, six lobes set between the petals.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-sans",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
