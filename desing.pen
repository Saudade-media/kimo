                },
                {
                  "type": "text",
                  "id": "qJAcR",
                  "name": "Traits",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 1600,
                  "content": "From A (Pill bloom): six offset pill lobes — the editor's radius-pill shape, the pinwheel lean that can spin while an agent works, six-fold symmetry. From F (Pucker): the solid round silhouette, a single closed opening at the centre, and survival at 16 px as 'a dot with a hole'. Each mix weights them differently.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-sans",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
