                  "type": "text",
                  "id": "f4G3Xa",
                  "name": "Body",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Root frame, component and instance labels render only when the root is at least 40 px wide on screen; narrower roots show no label (as in Figma). Keeps zoomed-out canvases with hundreds of roots readable and fast. When a nested component/instance label (shown for the selection) would overlap its root frame's label, the root label is hidden while the nested label is visible — the nested label wins.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-sans",
                  "fontSize": "$text-sm",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
