                          "name": "Rule",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "2 · Label pill sits below-right of the pointer; flips left/up within 8px of a viewport edge.",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-sans",
                          "fontSize": "$text-xs",
