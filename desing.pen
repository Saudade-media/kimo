                              "name": "Why label",
                              "fill": "$text-tertiary",
                              "content": "WHY",
                              "fontFamily": "$font-mono",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c3ztE",
                              "name": "Why",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Takes A's outline whole — the most recognisable, ownable shape of the three — and borrows F's soft lobed centre instead of A's tiny hex hole, so the opening stays visible down to 32 px.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-sans",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "m3dnf",
                              "name": "Risk label",
                              "fill": "$warning",
                              "content": "RISK",
                              "fontFamily": "$font-mono",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "rAWP1",
                              "name": "Risk",
                              "fill": "$text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Weights A heavily — inherits A's snowflake/flower reading at small sizes, and the scalloped edge is less calm on a squircle plate than a disc.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-sans",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        }
