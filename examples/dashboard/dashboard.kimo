{
"$schema": "https://getkimo.design/schema/kimo-1.0.json",
"format": "1.0.0",
"meta": {"name":"Northwind — dashboard","kimo.themes.order":["mode","density"]},
"themes": {"density":["comfortable","compact"],"mode":["light","dark"]},
"variables": {
"color/accent": {"type":"color","value":[{"value":"#4F46E5","when":{"mode":"light"}},{"value":"#8B8CFA","when":{"mode":"dark"}}],"group":"color"}

, "color/accent-soft": {"type":"color","value":[{"value":"#EEF2FF","when":{"mode":"light"}},{"value":"#1F1D4D","when":{"mode":"dark"}}],"group":"color"}

, "color/bg": {"type":"color","value":[{"value":"#F5F6F8","when":{"mode":"light"}},{"value":"#0B0D12","when":{"mode":"dark"}}],"group":"color"}

, "color/border": {"type":"color","value":[{"value":"#E4E7EC","when":{"mode":"light"}},{"value":"#262B36","when":{"mode":"dark"}}],"group":"color"}

, "color/ink": {"type":"color","value":[{"value":"#101828","when":{"mode":"light"}},{"value":"#F2F4F7","when":{"mode":"dark"}}],"group":"color"}

, "color/muted": {"type":"color","value":[{"value":"#667085","when":{"mode":"light"}},{"value":"#98A2B3","when":{"mode":"dark"}}],"group":"color"}

, "color/on-accent": {"type":"color","value":"#FFFFFF","group":"color"}

, "color/success": {"type":"color","value":[{"value":"#067647","when":{"mode":"light"}},{"value":"#47CD89","when":{"mode":"dark"}}],"group":"color"}

, "color/success-soft": {"type":"color","value":[{"value":"#ECFDF3","when":{"mode":"light"}},{"value":"#0A2E1D","when":{"mode":"dark"}}],"group":"color"}

, "color/surface": {"type":"color","value":[{"value":"#FFFFFF","when":{"mode":"light"}},{"value":"#141821","when":{"mode":"dark"}}],"group":"color"}

, "color/warning": {"type":"color","value":[{"value":"#B54708","when":{"mode":"light"}},{"value":"#FDB022","when":{"mode":"dark"}}],"group":"color"}

, "color/warning-soft": {"type":"color","value":[{"value":"#FFFAEB","when":{"mode":"light"}},{"value":"#3A2108","when":{"mode":"dark"}}],"group":"color"}

, "radius/card": {"type":"number","value":12,"group":"radius"}

, "radius/control": {"type":"number","value":8,"group":"radius"}

, "size/row": {"type":"number","value":[{"value":40,"when":{"density":"comfortable"}},{"value":30,"when":{"density":"compact"}}],"group":"size"}

, "space/l": {"type":"number","value":[{"value":24,"when":{"density":"comfortable"}},{"value":16,"when":{"density":"compact"}}],"group":"space"}

, "space/m": {"type":"number","value":[{"value":16,"when":{"density":"comfortable"}},{"value":12,"when":{"density":"compact"}}],"group":"space"}

, "space/s": {"type":"number","value":[{"value":12,"when":{"density":"comfortable"}},{"value":8,"when":{"density":"compact"}}],"group":"space"}

, "space/xl": {"type":"number","value":[{"value":32,"when":{"density":"comfortable"}},{"value":20,"when":{"density":"compact"}}],"group":"space"}

, "space/xs": {"type":"number","value":[{"value":6,"when":{"density":"comfortable"}},{"value":4,"when":{"density":"compact"}}],"group":"space"}
},
"nodes": {
