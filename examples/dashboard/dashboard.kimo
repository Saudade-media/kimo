, "db0008": {"type":"frame","parent":"db0007","order":"a0","name":"Brand","layout":{"dir":"row","gap":10,"pad":[0,0,16,4],"align":"center"}}

, "db0009": {"type":"rect","parent":"db0008","order":"a0","name":"Logo","w":28,"h":28,"radius":8,"fill":{"kind":"linear","stops":[{"at":0,"color":"#4F46E5"},{"at":1,"color":"#06B6D4"}],"rotation":135}}

, "db0010": {"type":"text","parent":"db0008","order":"a1","name":"Name","content":"Northwind","style":{"font":"Inter","size":17,"weight":700},"fill":{"$ref":"color/ink"}}

