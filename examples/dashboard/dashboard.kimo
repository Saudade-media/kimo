, "dbBtnPrim1": {"type":"frame","parent":"db0001","order":"a0","name":"Button/Primary","component":{"props":{"label":{"type":"text","order":"a0","target":"dbBtnLabel","field":"content","default":"Button"}}},"radius":{"$ref":"radius/control"},"fill":{"$ref":"color/accent"},"layout":{"dir":"row","gap":8,"pad":[8,14],"align":"center"},"meta":{"kimo.component.description":"Primary action. One per view."}}

, "dbBtnSec01": {"type":"instance","parent":"db0001","order":"a1","name":"Button/Secondary","of":"dbBtnPrim1","component":true,"props":{"fill":{"$ref":"color/surface"},"stroke":{"paint":{"$ref":"color/border"}}},"overrides":{"dbBtnLabel":{"set":{"fill":{"$ref":"color/ink"}}}}}

, "dbCompBrd1": {"type":"frame","parent":null,"order":"a0","name":"Components","x":0,"y":1040,"radius":16,"fill":{"$ref":"color/bg"},"layout":{"dir":"row","gap":48,"pad":48}}

, "dbDashbrd1": {"type":"frame","parent":"dbBoard001","order":"a0","name":"Dashboard","component":true,"w":1280,"h":800,"radius":16,"clip":true,"fill":{"$ref":"color/bg"},"layout":{"dir":"row"},"meta":{"kimo.component.description":"Overview screen; follows mode and density."}}

, "dbNavActv1": {"type":"instance","parent":"db0003","order":"a1","name":"NavItem/Active","of":"dbNavItem1","component":true,"props":{"fill":{"$ref":"color/accent-soft"}},"overrides":{"dbNavIcon1":{"set":{"color":{"$ref":"color/accent"}}},"dbNavLabel":{"set":{"style":{"font":"Inter","size":14,"weight":600},"fill":{"$ref":"color/accent"}}}}}

, "dbNavIcon1": {"type":"icon","parent":"dbNavItem1","order":"a0","name":"Icon","w":18,"h":18,"set":"lucide","icon":"circle","color":{"$ref":"color/muted"}}

, "dbNavItem1": {"type":"frame","parent":"db0003","order":"a0","name":"NavItem","component":{"props":{"label":{"type":"text","order":"a0","target":"dbNavLabel","field":"content","default":"Item"}}},"w":200,"radius":{"$ref":"radius/control"},"layout":{"dir":"row","gap":10,"pad":[7,10],"align":"center"}}

, "dbNavLabel": {"type":"text","parent":"dbNavItem1","order":"a1","name":"Label","content":"Item","style":{"font":"Inter","size":14,"weight":500},"fill":{"$ref":"color/muted"}}

, "dbRowProd1": {"type":"text","parent":"dbTableRow","order":"a0","name":"Product","w":{"mode":"fill"},"content":"Product","grow":"fixed-width","style":{"font":"Inter","size":14,"weight":500},"fill":{"$ref":"color/ink"}}

, "dbRowRev01": {"type":"text","parent":"dbTableRow","order":"a2","name":"Revenue","w":88,"content":"$0","grow":"fixed-width","style":{"font":"Inter","size":14,"weight":600,"align":"right"},"fill":{"$ref":"color/ink"}}

, "dbRowUnit1": {"type":"text","parent":"dbTableRow","order":"a1","name":"Units","w":64,"content":"0","grow":"fixed-width","style":{"font":"Inter","size":14,"weight":400,"align":"right"},"fill":{"$ref":"color/muted"}}

, "dbStatBdg1": {"type":"instance","parent":"db0005","order":"a0","name":"Trend","of":"dbBdgSucc1"}

, "dbStatCrd1": {"type":"frame","parent":"db0004","order":"a0","name":"StatCard","component":{"props":{"delta":{"type":"text","order":"a2","target":"dbStatBdg1/dbBdgLabel","field":"content","default":"+0%"},"label":{"type":"text","order":"a0","target":"dbStatLbl1","field":"content","default":"Metric"},"trend":{"type":"instance","order":"a3","target":"dbStatBdg1","default":"dbBdgSucc1"},"value":{"type":"text","order":"a1","target":"dbStatVal1","field":"content","default":"0"}}},"w":260,"radius":{"$ref":"radius/card"},"fill":{"$ref":"color/surface"},"stroke":{"paint":{"$ref":"color/border"}},"layout":{"dir":"column","gap":{"$ref":"space/xs"},"pad":{"$ref":"space/m"}}}

, "dbStatLbl1": {"type":"text","parent":"dbStatCrd1","order":"a0","name":"Label","content":"Metric","style":{"font":"Inter","size":13,"weight":500},"fill":{"$ref":"color/muted"}}

, "dbStatVal1": {"type":"text","parent":"dbStatCrd1","order":"a1","name":"Value","content":"0","style":{"font":"Inter","size":28,"weight":700,"letterSpacing":-0.6},"fill":{"$ref":"color/ink"}}

, "dbTableRow": {"type":"frame","parent":"db0004","order":"a1","name":"TableRow","component":{"props":{"product":{"type":"text","order":"a0","target":"dbRowProd1","field":"content","default":"Product"},"revenue":{"type":"text","order":"a2","target":"dbRowRev01","field":"content","default":"$0"},"units":{"type":"text","order":"a1","target":"dbRowUnit1","field":"content","default":"0"}}},"w":360,"h":{"$ref":"size/row"},"stroke":{"paint":{"$ref":"color/border"},"width":{"t":1}},"layout":{"dir":"row","gap":{"$ref":"space/s"},"align":"center"}}
}
