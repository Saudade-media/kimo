, "dbBdgSucc1": {"type":"frame","parent":"db0002","order":"a0","name":"Badge/Success","component":{"props":{"label":{"type":"text","order":"a0","target":"dbBdgLabel","field":"content","default":"+0%"}}},"radius":999,"fill":{"$ref":"color/success-soft"},"layout":{"dir":"row","gap":4,"pad":[2,8],"align":"center"}}

, "dbBdgWarn1": {"type":"instance","parent":"db0002","order":"a1","name":"Badge/Warning","of":"dbBdgSucc1","component":true,"props":{"fill":{"$ref":"color/warning-soft"}},"overrides":{"dbBdgIcon1":{"set":{"icon":"trending-down","color":{"$ref":"color/warning"}}},"dbBdgLabel":{"set":{"fill":{"$ref":"color/warning"}}}}}

