{
"$schema": "https://kimo.design/schema/kimo-0.1.json",
"format": "0.1.0",
"features": ["tokens/composite"],
"meta": {"name":"Kimo DS","library":true},
"themes": {"mode":["light","dark"]},
"variables": {
"color/accent": {"type":"color","value":[{"value":"#2563EB","when":{"mode":"light"}},{"value":"#60A5FA","when":{"mode":"dark"}}],"group":"color"}

, "color/accent-soft": {"type":"color","value":[{"value":"#E8F0FE","when":{"mode":"light"}},{"value":"#13233F","when":{"mode":"dark"}}],"group":"color"}

, "color/bg": {"type":"color","value":[{"value":"#F7F7F8","when":{"mode":"light"}},{"value":"#0E0F12","when":{"mode":"dark"}}],"group":"color"}

, "color/border": {"type":"color","value":[{"value":"#E3E4E8","when":{"mode":"light"}},{"value":"#2A2D35","when":{"mode":"dark"}}],"group":"color"}

, "color/danger": {"type":"color","value":[{"value":"#DC2626","when":{"mode":"light"}},{"value":"#F87171","when":{"mode":"dark"}}],"group":"color"}

, "color/ink": {"type":"color","value":[{"value":"#111216","when":{"mode":"light"}},{"value":"#F3F4F6","when":{"mode":"dark"}}],"group":"color"}

, "color/muted": {"type":"color","value":[{"value":"#5F6370","when":{"mode":"light"}},{"value":"#9CA0AB","when":{"mode":"dark"}}],"group":"color"}

, "color/on-accent": {"type":"color","value":"#FFFFFF","group":"color"}

, "color/surface": {"type":"color","value":[{"value":"#FFFFFF","when":{"mode":"light"}},{"value":"#17191E","when":{"mode":"dark"}}],"group":"color"}

, "radius/card": {"type":"number","value":14,"group":"radius"}

, "radius/control": {"type":"number","value":8,"group":"radius"}

, "shadow/card": {"type":"shadow","value":[{"kind":"shadow","x":0,"y":1,"blur":2,"color":"#1018280F"},{"kind":"shadow","x":0,"y":8,"blur":24,"spread":-8,"color":"#1018281F"}],"group":"shadow"}

, "space/2": {"type":"number","value":8,"group":"space"}

, "space/3": {"type":"number","value":12,"group":"space"}

, "space/4": {"type":"number","value":16,"group":"space"}

, "space/6": {"type":"number","value":24,"group":"space"}

, "type/body": {"type":"typography","value":{"font":"Inter","size":14,"weight":400,"lineHeight":1.5},"group":"typography"}

, "type/heading": {"type":"typography","value":{"font":"Inter","size":22,"weight":700,"lineHeight":1.25,"letterSpacing":-0.3},"group":"typography"}

, "type/label": {"type":"typography","value":{"font":"Inter","size":13,"weight":600},"group":"typography"}
},
"nodes": {
