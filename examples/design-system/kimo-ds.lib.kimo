, "DsBtnPrim1": {"type":"frame","parent":"ds0031","order":"a0","name":"Button/Primary","component":{"props":{"label":{"type":"text","order":"a0","target":"DsBtnLabel","field":"content","default":"Button"}}},"radius":{"$ref":"radius/control"},"fill":{"$ref":"color/accent"},"layout":{"dir":"row","gap":8,"pad":[10,16],"align":"center"},"meta":{"kimo.component.description":"The main call to action."}}

, "DsBtnSec01": {"type":"instance","parent":"ds0031","order":"a1","name":"Button/Secondary","of":"DsBtnPrim1","component":true,"props":{"fill":{"$ref":"color/surface"},"stroke":{"paint":{"$ref":"color/border"}}},"overrides":{"DsBtnLabel":{"set":{"fill":{"$ref":"color/ink"}}}}}

