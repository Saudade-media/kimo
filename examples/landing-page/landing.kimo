, "lp0018": {"type":"text","parent":"lp0012","order":"a2","name":"Subhead","w":640,"content":"Lumen turns product events into plain-language answers. No SQL, no dashboards nobody opens — just the numbers that move your week.","grow":"fixed-width","style":{"font":"Inter","size":19,"weight":400,"lineHeight":1.5,"align":"center"},"fill":{"$ref":"color/muted"}}

