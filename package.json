{
  "name": "kimo",
  "private": true,
  "description": "Kimo — an open-source, local-first, agent-native design canvas.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun run check:generated && bun run test",
    "check:generated": "bun run --filter '*' check:generated && bun scripts/gen-scope-checklist.ts --check",
    "gen:scope-checklist": "bun scripts/gen-scope-checklist.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
