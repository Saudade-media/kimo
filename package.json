{
  "name": "kimo",
  "private": true,
  "description": "Kimo \u2014 an open-source, local-first, agent-native design canvas.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json && tsc -p scripts/templates/tsconfig.json",
    "test": "scripts/test-all.sh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun run check:generated && bun run test",
    "check:generated": "bun run --filter '*' check:generated && bun scripts/gen-scope-checklist.ts --check",
    "gen:scope-checklist": "bun scripts/gen-scope-checklist.ts",
    "build:examples": "bun scripts/build-examples.ts",
    "check:examples": "bun scripts/build-examples.ts --check && kimo validate --strict examples/*/*.kimo",
    "build:templates": "bun scripts/build-templates.ts",
    "check:templates": "bun scripts/build-templates.ts --check && kimo validate --strict packages/templates/files/*/*.kimo",
    "screenshots:readme": "bun --filter @kimo/web screenshots:readme",
    "version:plan": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@kimo/cli": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
