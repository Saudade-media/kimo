, "surface/card": {"type":"color","value":[{"value":"#FFFFFF"},{"value":"#FFFFFF","when":{"mode":"light"}},{"value":{"$ref":"ink-900"},"when":{"mode":"dark"}},{"value":{"space":"display-p3","r":0.98,"g":0.97,"b":0.95},"when":{"density":"compact","mode":"light"}}],"description":"Card background","group":"color.surface"}

