, "Card000001": {"type":"frame","parent":null,"order":"a1","name":"Card/Pricing","component":{"props":{"actions":{"type":"slot","order":"w","target":"CardActs01"},"icon":{"type":"instance","order":"u","target":"CardIcon01","default":"Arrow00001"},"label":{"type":"text","order":"V","target":"CardCta001","field":"content","default":"Call to action"},"showBadge":{"type":"boolean","order":"k","target":"CardBadge1","field":"visible","default":false},"size":{"type":"enum","order":"r","target":"Card000001","field":"layout","options":{"md":{"dir":"column","gap":10,"pad":[12,20]},"sm":{"dir":"column","gap":8,"pad":[8,16]}}}}},"x":640,"y":62,"w":220,"fill":{"$ref":"surface/card"},"layout":{"dir":"column","gap":10,"pad":{"$ref":"space/card-pad"}},"meta":{"kimo.component.description":"Pricing tier card — CTAs go in actions."}}

