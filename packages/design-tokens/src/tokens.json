        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-8"
        }
      },
      "10": {
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-10"
        }
      },
      "12": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-12"
        }
      },
      "$type": "dimension"
    },
    "radius": {
      "$type": "dimension",
      "2xs": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "radius-2xs"
        }
      },
      "xs": {
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "radius-xs"
        }
      },
      "sm": {
        "$value": {
          "value": 6,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "radius-sm"
        }
      },
      "md": {
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "radius-md"
        }
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
