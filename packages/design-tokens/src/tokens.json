          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "text-3xl"
        }
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "$description": "Weights used by .pen text nodes (400 is the node default when fontWeight is unset).",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
