{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Kimo editor design tokens, transcribed 1:1 from desing.pen (boards 01 Foundations, 02 Components). Source of truth for src/generated/*. Run `bun run build:tokens` after editing.",
  "$extensions": {
    "kimo.modes": {
      "axis": "mode",
      "values": ["light", "dark"],
      "default": "light",
      "convention": "A mode-dependent token's $value is its light (default) value; $extensions['kimo.modes'] holds the value for every mode. Aliases to mode-dependent tokens follow the mode automatically."
    }
  },
  "primitive": {
    "$description": "Mode-independent scales. Names mirror the .pen variables.",
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": "Inter",
        "$extensions": {
          "kimo.pen": "font-sans",
          "kimo.fallback": ["ui-sans-serif", "system-ui", "sans-serif"]
        }
      },
      "mono": {
        "$value": "JetBrains Mono",
        "$extensions": {
          "kimo.pen": "font-mono",
          "kimo.fallback": ["ui-monospace", "monospace"]
        }
      }
    },
    "space": {
      "1": {
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-1"
        }
      },
      "2": {
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-2"
        }
      },
      "3": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-3"
        }
      },
      "4": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-4"
        }
      },
      "5": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-5"
        }
      },
      "6": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "kimo.pen": "space-6"
        }
      },
