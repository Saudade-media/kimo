{
"$schema": "https://kimo.design/schema/kimo-1.0.json",
"format": "1.0.0",
"features": ["text/runs"],
"meta": {"name":"Text styles"},
"themes": {"mode":["light","dark"]},
"variables": {
"body": {"type":"number","value":15}

, "ink": {"type":"color","value":[{"value":"#18181B","when":{"mode":"light"}},{"value":"#FAFAFA","when":{"mode":"dark"}}]}

, "sans": {"type":"string","value":"Inter"}

, "surface": {"type":"color","value":[{"value":"#FFFFFF","when":{"mode":"light"}},{"value":"#18181B","when":{"mode":"dark"}}]}
},
"nodes": {
"Card000001": {"type":"frame","parent":"Text000001","order":"a3","name":"Dark card","theme":{"mode":"dark"},"radius":12,"fill":{"$ref":"surface"},"layout":{"dir":"column","gap":6,"pad":16}}

, "CardText01": {"type":"text","parent":"Card000001","order":"a0","name":"Dark title","content":"On dark","style":{"font":{"$ref":"sans"},"size":{"$ref":"body"},"weight":600},"fill":{"$ref":"ink"}}

, "Deco000001": {"type":"text","parent":"Text000001","order":"a2","name":"Decorated","content":"Underlined, struck, italic, tabular 0123","style":{"font":"Inter","size":14,"italic":true,"decoration":["underline","strike"],"features":{"liga":false,"tnum":true}}}

, "Heading001": {"type":"text","parent":"Text000001","order":"a0","name":"Heading","content":"Export exactly","style":{"font":"Inter","size":32,"weight":700,"lineHeight":1.2,"letterSpacing":-0.5},"fill":{"$ref":"ink"},"meta":{"kimo.export.tag":"h1"}}

, "Runs000001": {"type":"text","parent":"Text000001","order":"a1","name":"Runs","w":360,"content":[{"text":"Mixed "},{"text":"bold","style":{"weight":700}},{"text":" and "},{"text":"linked","style":{"decoration":["underline"]},"href":"https://kimo.design"},{"text":" runs in one paragraph."}],"grow":"fixed-width","style":{"font":"Inter","size":16,"lineHeight":1.5}}

, "Text000001": {"type":"frame","parent":null,"order":"a0","name":"Text","x":0,"y":0,"w":480,"fill":{"$ref":"surface"},"layout":{"dir":"column","gap":10,"pad":24}}
}
}
