{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "kimo.themes": {
      "axes": {
        "density": {
          "values": [
            "comfortable",
            "compact"
          ],
          "default": "comfortable",
          "attribute": "data-density"
        },
        "mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-mode"
        }
      }
    }
  },
  "ink-900": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [
        0.24,
        0.03,
        55
      ]
    },
    "$extensions": {
      "kimo.variable": "ink-900"
    }
  },
  "space": {
    "card": {
      "space": {
        "card-pad": {
          "$type": "number",
          "$value": 20,
          "$extensions": {
            "kimo.variable": "space/card-pad",
            "kimo.themes": [
              {
                "value": 16
              },
              {
                "when": {
                  "density": "compact"
                },
                "value": 12
              },
              {
                "when": {
                  "density": "comfortable"
                },
                "value": 20
              }
            ]
          }
        }
      }
    }
  },
  "color": {
    "surface": {
      "card": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        },
        "$description": "Card background",
        "$extensions": {
          "kimo.variable": "surface/card",
          "kimo.themes": [
            {
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "hex": "#ffffff"
              }
            },
            {
              "when": {
                "mode": "light"
              },
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "hex": "#ffffff"
              }
            },
            {
              "when": {
                "mode": "dark"
              },
              "value": "{ink-900}"
            },
            {
              "when": {
                "density": "compact",
                "mode": "light"
              },
              "value": {
                "colorSpace": "display-p3",
                "components": [
                  0.98,
                  0.97,
                  0.95
                ]
              }
            }
          ]
        }
      }
    }
  },
  "text": {
    "default": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1647,
          0.1176,
          0.0784
        ],
        "hex": "#2a1e14"
      },
      "$extensions": {
        "kimo.variable": "text/default",
        "kimo.themes": [
          {
            "when": {
              "mode": "light"
            },
            "value": {
              "colorSpace": "srgb",
              "components": [
                0.1647,
                0.1176,
                0.0784
              ],
              "hex": "#2a1e14"
            }
          },
          {
            "when": {
              "mode": "dark"
            },
            "value": {
              "colorSpace": "srgb",
              "components": [
                0.9608,
                0.9333,
                0.902
              ],
              "hex": "#f5eee6"
            }
          }
        ]
      }
    }
  }
}
