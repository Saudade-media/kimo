{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "kimo.themes": {
      "axes": {
        "mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-mode"
        },
        "ui:mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-ui-mode"
        }
      }
    }
  },
  "ink": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [
        0.0667,
        0.0667,
        0.0667
      ],
      "hex": "#111111"
    },
    "$extensions": {
      "kimo.variable": "ink",
      "kimo.themes": [
        {
          "when": {
            "mode": "light"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              0.0667,
              0.0667,
              0.0667
            ],
            "hex": "#111111"
          }
        },
        {
          "when": {
            "mode": "dark"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              0.9569,
              0.9569,
              0.9608
            ],
            "hex": "#f4f4f5"
          }
        }
      ]
    }
  },
  "radius-m": {
    "$type": "number",
    "$value": 8,
    "$extensions": {
      "kimo.variable": "radius-m"
    }
  },
  "space-m": {
    "$type": "number",
    "$value": 16,
    "$extensions": {
      "kimo.variable": "space-m"
    }
  },
  "surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [
        1,
        1,
        1
      ],
      "hex": "#ffffff"
    },
    "$extensions": {
      "kimo.variable": "surface",
      "kimo.themes": [
        {
          "when": {
            "mode": "light"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          }
        },
        {
          "when": {
            "mode": "dark"
          },
          "value": {
            "colorSpace": "oklch",
            "components": [
              0.18,
              0.01,
              270
            ]
          }
        }
      ]
    }
  },
  "ui": {
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3098,
          0.2745,
          0.898
        ],
        "hex": "#4f46e5"
      },
      "$extensions": {
        "kimo.variable": "ui:accent",
        "kimo.themes": [
          {
            "when": {
              "ui:mode": "light"
            },
            "value": {
              "colorSpace": "srgb",
              "components": [
                0.3098,
                0.2745,
                0.898
              ],
              "hex": "#4f46e5"
            }
          },
          {
            "when": {
              "ui:mode": "dark"
            },
            "value": {
              "colorSpace": "oklch",
              "components": [
                0.7,
                0.15,
                275
              ]
            }
          }
        ]
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$extensions": {
        "kimo.variable": "ui:on-accent"
      }
    },
    "radius-pill": {
      "$type": "number",
      "$value": 999,
      "$extensions": {
        "kimo.variable": "ui:radius-pill"
      }
    }
  }
}
