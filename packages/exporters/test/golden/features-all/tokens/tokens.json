{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "kimo.themes": {
      "axes": {
        "mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-mode"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000",
        "alpha": 0.1216
      },
      "offsetX": {
        "value": 0,
        "unit": "px"
      },
      "offsetY": {
        "value": 4,
        "unit": "px"
      },
      "blur": {
        "value": 12,
        "unit": "px"
      },
      "spread": {
        "value": 0,
        "unit": "px"
      }
    },
    "$extensions": {
      "kimo.variable": "elevation",
      "kimo.themes": [
        {
          "when": {
            "mode": "light"
          },
          "value": {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "hex": "#000000",
              "alpha": 0.1216
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 4,
              "unit": "px"
            },
            "blur": {
              "value": 12,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        },
        {
          "when": {
            "mode": "dark"
          },
          "value": {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "hex": "#000000",
              "alpha": 0
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 0,
              "unit": "px"
            },
            "blur": {
              "value": 0,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        }
      ]
    }
  },
  "space-s": {
    "$type": "dimension",
    "$value": {
      "value": 8,
      "unit": "px"
    },
    "$extensions": {
      "kimo.variable": "space-s"
    }
  },
  "type-body": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter",
      "fontSize": {
        "value": 16,
        "unit": "px"
      },
      "lineHeight": {
        "px": 24
      }
    },
    "$extensions": {
      "kimo.variable": "type-body"
    }
  }
}
