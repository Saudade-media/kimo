{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "kimo.themes": {
      "axes": {
        "mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-mode"
        }
      }
    }
  },
  "body": {
    "$type": "number",
    "$value": 15,
    "$extensions": {
      "kimo.variable": "body"
    }
  },
  "ink": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [
        0.0941,
        0.0941,
        0.1059
      ],
      "hex": "#18181b"
    },
    "$extensions": {
      "kimo.variable": "ink",
      "kimo.themes": [
        {
          "when": {
            "mode": "light"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              0.0941,
              0.0941,
              0.1059
            ],
            "hex": "#18181b"
          }
        },
        {
          "when": {
            "mode": "dark"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              0.9804,
              0.9804,
              0.9804
            ],
            "hex": "#fafafa"
          }
        }
      ]
    }
  },
  "sans": {
    "$type": "fontFamily",
    "$value": "Inter",
    "$extensions": {
      "kimo.variable": "sans"
    }
  },
  "surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [
        1,
        1,
        1
      ],
      "hex": "#ffffff"
    },
    "$extensions": {
      "kimo.variable": "surface",
      "kimo.themes": [
        {
          "when": {
            "mode": "light"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "hex": "#ffffff"
          }
        },
        {
          "when": {
            "mode": "dark"
          },
          "value": {
            "colorSpace": "srgb",
            "components": [
              0.0941,
              0.0941,
              0.1059
            ],
            "hex": "#18181b"
          }
        }
      ]
    }
  }
}
