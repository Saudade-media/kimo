{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "kimo.themes": {
      "axes": {
        "brand": {
          "values": [
            "kimo",
            "acme"
          ],
          "default": "kimo",
          "attribute": "data-brand"
        },
        "density": {
          "values": [
            "regular",
            "compact"
          ],
          "default": "regular",
          "attribute": "data-density"
        },
        "mode": {
          "values": [
            "light",
            "dark"
          ],
          "default": "light",
          "attribute": "data-mode"
        }
      }
    }
  },
  "color": {
    "surface": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        },
        "$description": "Page background",
        "$extensions": {
          "kimo.variable": "bg",
          "kimo.themes": [
            {
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "hex": "#ffffff"
              }
            },
            {
              "when": {
                "mode": "light"
              },
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "hex": "#ffffff"
              }
            },
            {
              "when": {
                "mode": "dark"
              },
              "value": {
                "colorSpace": "srgb",
                "components": [
                  0.0431,
                  0.0431,
                  0.0588
                ],
                "hex": "#0b0b0f"
              }
            },
            {
              "when": {
                "brand": "acme",
                "mode": "light"
              },
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  0.9725,
                  0.9412
                ],
                "hex": "#fff8f0"
              }
            }
          ]
        }
      }
    }
  },
  "bg-alias": {
    "$type": "color",
    "$value": "{color.surface.bg}",
    "$extensions": {
      "kimo.variable": "bg-alias"
    }
  },
  "headline": {
    "$value": "Hello",
    "$extensions": {
      "kimo.variable": "headline",
      "kimo.type": "string",
      "kimo.themes": [
        {
          "value": "Hello"
        },
        {
          "when": {
            "brand": "acme"
          },
          "value": "Howdy"
        },
        {
          "when": {
            "brand": "kimo"
          },
          "value": "Hello"
        }
      ]
    }
  },
  "pad": {
    "$type": "number",
    "$value": 24,
    "$extensions": {
      "kimo.variable": "pad",
      "kimo.themes": [
        {
          "when": {
            "density": "regular"
          },
          "value": 24
        },
        {
          "when": {
            "density": "compact"
          },
          "value": 12
        }
      ]
    }
  },
  "show-promo": {
    "$value": false,
    "$extensions": {
      "kimo.variable": "show-promo",
      "kimo.type": "boolean",
      "kimo.themes": [
        {
          "value": false
        },
        {
          "when": {
            "brand": "acme"
          },
          "value": true
        }
      ]
    }
  }
}
