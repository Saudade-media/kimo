  "private": true,
  "description": "Kimo MCP tool registry (single source), socket protocol, host attach/headless runtime and host installer",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
