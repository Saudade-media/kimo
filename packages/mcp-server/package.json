    "@kimo/platform": "workspace:*",
    "@kimo/renderer": "workspace:*",
    "@kimo/sync": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "^8.19.0",
    "quickjs-emscripten-core": "0.32.0",
    "typebox": "^1.4.2"
