{
  "name": "@kimo/renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Renderer interface + CanvasKit (Skia WASM) implementation: interactive WebGL and headless raster",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./test",
    "test:update-goldens": "UPDATE_GOLDENS=1 bun test ./test",
    "bench": "bun run test/bench/perf-5k.ts",
    "e2e:browser": "bun run test/browser/run.ts",
    "icons": "bun run scripts/build-icon-packs.ts",
    "bench:instances": "bun run test/bench/perf-instances.ts"
  },
  "dependencies": {
    "@kimo/core-schema": "workspace:*",
    "@kimo/layout": "workspace:*",
    "@material-symbols/svg-400": "^0.47.5",
    "@phosphor-icons/core": "^2.1.1",
    "canvaskit-wasm": "^0.42.0",
    "feather-icons": "^4.29.2",
    "lucide-static": "^1.49.0"
  },
  "files": [
    "src",
    "assets"
  ],
  "devDependencies": {
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "vite": "^8.3.2"
  }
}
