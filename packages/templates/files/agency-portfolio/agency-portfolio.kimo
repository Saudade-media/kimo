, "ap00007t": {"type":"instance","parent":"ap00007s","order":"a0","of":"apQuote","args":{"initials":"MV","name":"Marieke Vos","quote":"Oriel spent the first two weeks behind our counters and in the roastery. The identity they came back with looks like us on a good day, and our baristas use the guidelines without asking.","role":"Founder, Hollis Coffee Roasters","tone":"inverse"}}

, "ap00007u": {"type":"frame","parent":"ap00006n","order":"a7","name":"Process","w":{"mode":"fill"},"layout":{"dir":"row","gap":{"$ref":"space/12"},"pad":[96,120,64,120]}}

