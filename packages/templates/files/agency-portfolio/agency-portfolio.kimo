, "ap00007w": {"type":"text","parent":"ap00007u","order":"a1","name":"Labels print on a single press sheet in…","w":{"mode":"fill"},"content":"Labels print on a single press sheet in two colours. Each origin gets a tint from the clay palette, and the brew guide on the back is set in one size so it reads on a shelf and in the hand.","grow":"fixed-width","style":{"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/muted"}}

