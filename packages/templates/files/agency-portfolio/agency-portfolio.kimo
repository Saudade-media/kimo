, "ap00008d": {"type":"text","parent":"ap00008c","order":"a0","name":"Noor van Dijk started Oriel in 2017 aft…","w":{"mode":"fill"},"content":"Noor van Dijk started Oriel in 2017 after eight years at agencies in Amsterdam and London. She wanted a studio small enough that the people who pitch the work also make it.","grow":"fixed-width","style":{"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/muted"}}

, "ap00008e": {"type":"text","parent":"ap00008c","order":"a1","name":"We take on about eight projects a year.…","w":{"mode":"fill"},"content":"We take on about eight projects a year. Each one gets a lead designer from start to finish, and clients talk to the people doing the work, not to an account manager.","grow":"fixed-width","style":{"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/muted"}}

