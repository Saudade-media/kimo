, "ec000098": {"type":"text","parent":"ec000091","order":"a4","name":"Hana leads design for navigation at Nor…","w":{"mode":"fill"},"content":"Hana leads design for navigation at Northwind Maps, where her team of 14 works on routing, search and offline maps used by 60 million people a month. Before that she designed ticket machines for the Tokyo Metro, which she still calls the hardest interface she has worked on.","grow":"fixed-width","style":{"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/ink"}}

, "ec000099": {"type":"text","parent":"ec000091","order":"a5","name":"She lives in Malmö and commutes to Cope…","w":{"mode":"fill"},"content":"She lives in Malmö and commutes to Copenhagen, usually with the app open to see if it gets the train right.","grow":"fixed-width","style":{"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/muted"}}

