, "ec00008l": {"type":"text","parent":"ec00008k","order":"a0","name":"Hana leads design for navigation at Nor…","w":{"mode":"fill"},"content":"Hana leads design for navigation at Northwind Maps, where her team of 14 works on routing, search and offline maps used by 60 million people a month. Before that she designed ticket machines for the Tokyo Metro, which she still calls the hardest interface she has worked on.","grow":"fixed-width","style":{"size":28,"weight":500,"letterSpacing":-0.9,"typography":{"$ref":"type/lead"}},"fill":{"$ref":"color/ink"}}

, "ec00008m": {"type":"text","parent":"ec00008k","order":"a1","name":"She lives in Malmö and commutes to Cope…","w":{"mode":"fill"},"content":"She lives in Malmö and commutes to Copenhagen, usually with the app open to see if it gets the train right.","grow":"fixed-width","style":{"size":18,"typography":{"$ref":"type/body"}},"fill":{"$ref":"color/muted"}}

