"meta": {"name":"Tidewell personal banking","kimo.template":{"category":"Mobile","description":"Seven-screen iPhone app for a personal bank: passcode sign-in, a balance slab with activity, a receipt, sending money, a frozen card and monthly insights.","slug":"mobile-banking"}},
"themes": {"mode":["light","dark"]},
