, "color/sidebar": {"type":"color","value":[{"value":"#FBFBFC","when":{"mode":"light"}},{"value":"#11141B","when":{"mode":"dark"}}],"group":"color"}

, "color/subtle": {"type":"color","value":[{"value":"#F0F2F5","when":{"mode":"light"}},{"value":"#1B1F2A","when":{"mode":"dark"}}],"group":"color"}

, "color/success": {"type":"color","value":[{"value":"#15803D","when":{"mode":"light"}},{"value":"#4ADE80","when":{"mode":"dark"}}],"group":"color"}

, "color/success-soft": {"type":"color","value":[{"value":"#E7F6EC","when":{"mode":"light"}},{"value":"#12301E","when":{"mode":"dark"}}],"group":"color"}

, "color/surface": {"type":"color","value":[{"value":"#FFFFFF","when":{"mode":"light"}},{"value":"#151821","when":{"mode":"dark"}}],"group":"color"}

, "color/tone-1": {"type":"color","value":[{"value":"#DCD6FF","when":{"mode":"light"}},{"value":"#3A3170","when":{"mode":"dark"}}],"group":"color"}

, "color/tone-2": {"type":"color","value":[{"value":"#CFEFE0","when":{"mode":"light"}},{"value":"#1D4A35","when":{"mode":"dark"}}],"group":"color"}

, "color/tone-3": {"type":"color","value":[{"value":"#FBE2BE","when":{"mode":"light"}},{"value":"#59401A","when":{"mode":"dark"}}],"group":"color"}

, "color/tone-4": {"type":"color","value":[{"value":"#F9D4D0","when":{"mode":"light"}},{"value":"#5A2620","when":{"mode":"dark"}}],"group":"color"}

, "color/warning": {"type":"color","value":[{"value":"#B45309","when":{"mode":"light"}},{"value":"#FBBF24","when":{"mode":"dark"}}],"group":"color"}

, "color/warning-soft": {"type":"color","value":[{"value":"#FDF3E1","when":{"mode":"light"}},{"value":"#3A2A0B","when":{"mode":"dark"}}],"group":"color"}

, "radius/lg": {"type":"number","value":12,"group":"radius"}

, "radius/md": {"type":"number","value":8,"group":"radius"}

, "radius/pill": {"type":"number","value":999,"group":"radius"}

, "radius/sm": {"type":"number","value":6,"group":"radius"}

, "shadow/card": {"type":"shadow","value":[{"kind":"shadow","x":0,"y":1,"blur":2,"color":"#1118270D"},{"kind":"shadow","x":0,"y":4,"blur":12,"spread":-4,"color":"#11182714"}],"group":"shadow"}

, "size/sidebar": {"type":"number","value":248,"group":"size"}

, "size/topbar": {"type":"number","value":64,"group":"size"}

, "space/1": {"type":"number","value":4,"group":"space"}

, "space/2": {"type":"number","value":8,"group":"space"}

, "space/3": {"type":"number","value":12,"group":"space"}

, "space/4": {"type":"number","value":16,"group":"space"}

, "space/5": {"type":"number","value":20,"group":"space"}

, "space/6": {"type":"number","value":24,"group":"space"}

, "space/8": {"type":"number","value":32,"group":"space"}

, "type/body": {"type":"typography","value":{"font":"Inter","size":14,"weight":400,"lineHeight":1.5},"group":"typography"}

, "type/display": {"type":"typography","value":{"font":"Inter","size":56,"weight":700,"lineHeight":1.05,"letterSpacing":-1.6},"group":"typography"}

