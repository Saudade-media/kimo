{
"$schema": "https://kimo.design/schema/kimo-1.0.json",
"format": "1.0.0",
"features": ["layout/stretch-baseline","layout/wrap","tokens/composite"],
"meta": {"name":"Fieldwork project tracker","kimo.template":{"category":"Web app","description":"Six-screen SaaS web app for a studio project tracker: dashboard, projects, kanban board, team, settings and billing.","slug":"saas-app"}},
"themes": {"mode":["light","dark"]},
"variables": {
"color/accent": {"type":"color","value":[{"value":"#5B4BDB","when":{"mode":"light"}},{"value":"#9D90FF","when":{"mode":"dark"}}],"group":"color"}

, "color/accent-soft": {"type":"color","value":[{"value":"#EEEBFF","when":{"mode":"light"}},{"value":"#231F45","when":{"mode":"dark"}}],"group":"color"}

, "color/bg": {"type":"color","value":[{"value":"#F6F7F9","when":{"mode":"light"}},{"value":"#0D0F14","when":{"mode":"dark"}}],"group":"color"}

, "color/border": {"type":"color","value":[{"value":"#E5E7EB","when":{"mode":"light"}},{"value":"#262B37","when":{"mode":"dark"}}],"group":"color"}

, "color/danger": {"type":"color","value":[{"value":"#C2410C","when":{"mode":"light"}},{"value":"#FB923C","when":{"mode":"dark"}}],"group":"color"}

, "color/danger-soft": {"type":"color","value":[{"value":"#FDEDE6","when":{"mode":"light"}},{"value":"#3A1A0D","when":{"mode":"dark"}}],"group":"color"}

, "color/ink": {"type":"color","value":[{"value":"#111827","when":{"mode":"light"}},{"value":"#F1F3F7","when":{"mode":"dark"}}],"group":"color"}

, "color/ink-2": {"type":"color","value":[{"value":"#374151","when":{"mode":"light"}},{"value":"#C9CFDA","when":{"mode":"dark"}}],"group":"color"}

