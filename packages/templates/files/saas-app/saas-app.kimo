, "type/label": {"type":"typography","value":{"font":"Inter","size":14,"weight":600,"lineHeight":1.3},"group":"typography"}

, "type/metric": {"type":"typography","value":{"font":"Inter","size":28,"weight":700,"lineHeight":1.15,"letterSpacing":-0.6},"group":"typography"}

, "type/mono": {"type":"typography","value":{"font":"JetBrains Mono","size":12,"weight":500,"lineHeight":1.4},"group":"typography"}

, "type/small": {"type":"typography","value":{"font":"Inter","size":12,"weight":400,"lineHeight":1.45},"group":"typography"}
},
"pages": {"saPage1":{"order":"p02","name":"Components"},"saPage2":{"order":"p01","name":"Screens"},"saPage3":{"order":"p00","name":"Cover"},"saPage4":{"order":"p03","name":"Foundations"}},
