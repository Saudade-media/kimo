, "lm0000kv": {"type":"text","parent":"lm0000kq","order":"a3","name":"Start with the trial balance as of year…","w":{"mode":"fill"},"content":"Start with the trial balance as of year-end, the prior year comparative and a tie-out of each balance sheet account to a bank statement, subledger or schedule. Teams that keep these attached to the month-end task have them on day one.","grow":"fixed-width","style":{"size":18,"lineHeight":1.65,"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/ink"}}

