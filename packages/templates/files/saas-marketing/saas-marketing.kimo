, "lm0000kr": {"type":"text","parent":"lm0000kq","order":"a0","name":"Auditors are not trying to be difficult…","w":{"mode":"fill"},"content":"Auditors are not trying to be difficult. They sample, and what they sample first is whatever is quickest to test. If the first request takes a week to answer, the next ones get bigger.","grow":"fixed-width","style":{"size":18,"lineHeight":1.65,"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/ink"}}

, "lm0000ks": {"type":"text","parent":"lm0000kq","order":"a1","name":"We read the opening request lists from …","w":{"mode":"fill"},"content":"We read the opening request lists from 31 year-end audits our customers shared. Six requests showed up in almost every one, in nearly the same order.","grow":"fixed-width","style":{"size":18,"lineHeight":1.65,"typography":{"$ref":"type/body-lg"}},"fill":{"$ref":"color/ink"}}

