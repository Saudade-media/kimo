ide lucide-circle-dot" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="12" r="10"></circle></svg></span><span class="kimo-confirm-dialog__item-text">Detach all: 9 instances become plain layers from the cached preview</span></li><li class="kimo-confirm-dialog__item"><span class="kimo-confirm-dialog__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg></span><span class="kimo-confirm-dialog__item-text">Without a cache (fresh clone), detach isn&#x27;t available. Locate the file instead</span></li><li class="kimo-confirm-dialog__item"><span class="kimo-confirm-dialog__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list" aria-hidden="true"><path d="M3 5h.01"></path><path d="M3 12h.01"></path><path d="M3 19h.01"></path><path d="M8 5h13"></path><path d="M8 12h13"></path><path d="M8 19h13"></path></svg></span><span class="kimo-confirm-dialog__item-text">Undo restores the import and the instances</span></li></ul><div class="kimo-confirm-dialog__footer"><span class="kimo-confirm-dialog__spacer" aria-hidden="true"></span><button type="button" class="kimo-button kimo-button--ghost kimo-confirm-dialog__cancel"><span class="kimo-button__label">Cancel</span></button><button type="button" class="